# ==========================================
# 🚀 NAUKRI AI CAREER PLATFORM - BACKEND CONFIG
# ==========================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Frontend Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# JWT Secret Key (Used for signing & verifying user authentication tokens)
# How to generate a secure secret: Run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=naukri_pro_super_secret_jwt_key_2026_secure_random_string_9981

# JWT Token Expiration Time (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Database Connection (MongoDB URI)
# For Local MongoDB: mongodb://127.0.0.1:27017/job_recruiter_db
# For MongoDB Atlas (Free Cloud): mongodb+srv://<username>:<password>@cluster0.mongodb.net/job_recruiter_db?retryWrites=true&w=majority
# (Note: The server includes an automatic resilient fallback store if MongoDB is offline)
MONGODB_URI=mongodb://127.0.0.1:27017/job_recruiter_db

# File Upload Destination Directory (Default: uploads)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
