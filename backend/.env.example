PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# MongoDB Connection String (Local or Cloud Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/job_recruiter_db

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
